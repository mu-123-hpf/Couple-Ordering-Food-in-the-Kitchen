[Unit]
Description=Couple Kitchen authenticated shared web application
After=network.target
[Service]
Type=simple
User=couple-kitchen
Group=couple-kitchen
WorkingDirectory=/opt/couple-kitchen/current
ExecStart=/usr/bin/python3 -m kitchen_app.server --host 127.0.0.1 --port 8765 --data /var/lib/couple-kitchen/kitchen.sqlite3
Environment=PYTHONUNBUFFERED=1
Environment=KITCHEN_SECURE_COOKIE=1
Environment=KITCHEN_PUBLIC_ORIGIN=https://kitchen.example.com
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/couple-kitchen
[Install]
WantedBy=multi-user.target
